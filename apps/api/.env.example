# ===========================================
# Hotel Assistant API - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Server
NODE_ENV=development
PORT=3001

# ===========================================
# SUPABASE DATABASE
# ===========================================
# Get from: Supabase Dashboard → Settings → Database → Connection string

# Pooler connection (port 6543) - for app queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ===========================================
# SUPABASE AUTH
# ===========================================
# Get from: Supabase Dashboard → Settings → API

# Project URL (without trailing slash)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Anon/Public Key (safe for frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (keep secret, server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret (for token validation)
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ===========================================
# REDIS (Optional)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# JWT AUTHENTICATION (Fallback)
# ===========================================
# Generate a secure random string for production:
# openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===========================================
# AI PROVIDER
# ===========================================
# Options: openai or anthropic
AI_PROVIDER=openai

# OpenAI - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
# Get API key from: https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key

# For TESTING (no domain needed): onboarding@resend.dev
# For PRODUCTION: noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev

# Webhook secret (optional - for delivery tracking)
RESEND_WEBHOOK_SECRET=

# Rate limits
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_RATE_LIMIT_PER_HOUR=500

# ===========================================
# FRONTEND URLs
# ===========================================
ADMIN_URL=http://localhost:3000

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# SECURITY
# ===========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Data encryption key - Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=generate-a-secure-32-byte-base64-key
