# ===========================================
# Hotel Assistant API - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Server
NODE_ENV=development
PORT=3001

# ===========================================
# NEON DATABASE
# ===========================================
# Get from: Neon Dashboard → Connection Details

# Pooled connection (for app queries) - includes Neon-optimized pool params
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/hotel_assistant?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15&connection_limit=10"

# Direct connection (for migrations)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/hotel_assistant?sslmode=require"

# ===========================================
# REDIS (Optional)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure random string for production:
# openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===========================================
# AI PROVIDER
# ===========================================
# Options: openai or anthropic
AI_PROVIDER=openai

# OpenAI - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
# Get API key from: https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key

# For TESTING (no domain needed): onboarding@resend.dev
# For PRODUCTION: noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev

# Webhook secret (optional - for delivery tracking)
RESEND_WEBHOOK_SECRET=

# Rate limits
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_RATE_LIMIT_PER_HOUR=500

# ===========================================
# S3-COMPATIBLE STORAGE (Cloudflare R2 / AWS S3 / MinIO)
# ===========================================
# For Cloudflare R2 (free tier):
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your-r2-access-key
# S3_SECRET_KEY=your-r2-secret-key
# S3_REGION=auto
# S3_BUCKET=hotel-files

# For AWS S3:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_REGION=us-east-1
# S3_BUCKET=hotel-files

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_BUCKET=hotel-files

# ===========================================
# FRONTEND URLs
# ===========================================
ADMIN_URL=http://localhost:3000

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# SECURITY
# ===========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Data encryption key - Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=generate-a-secure-32-byte-base64-key

# ===========================================
# SCRAPER SERVICE (Crawl4AI)
# ===========================================
SCRAPER_SERVICE_URL=http://localhost:3003

# Gemini API Key (used by scraper for knowledge extraction)
GEMINI_API_KEY=your-gemini-api-key
