generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Hotel entity - represents a tenant in the multi-tenant system
model Hotel {
  id                 String             @id @default(uuid())
  name               String             @db.VarChar(255)
  slug               String             @unique @db.VarChar(100)
  subdomain          String?            @unique @db.VarChar(63)
  email              String             @db.VarChar(255)
  phone              String?            @db.VarChar(50)
  address            Json?
  description        String?
  website            String?            @db.VarChar(2048)
  settings           Json               @default("{}")
  branding           Json               @default("{}")
  status             HotelStatus        @default(active)
  subscriptionTier   SubscriptionTier   @default(basic) @map("subscription_tier")
  subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  bookings           Booking[]
  conversations      Conversation[]
  knowledge          HotelKnowledge[]
  rooms              Room[]
  scrapeJobs         ScrapeJob[]
  users              User[]

  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@map("hotels")
}

/// User entity - hotel staff and administrators
model User {
  id                      String                   @id @default(uuid())
  hotelId                 String?                  @map("hotel_id")
  email                   String                   @db.VarChar(255)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  name                    String                   @db.VarChar(255)
  role                    UserRole
  jobTitle                String?                  @map("job_title") @db.VarChar(100)
  status                  UserStatus               @default(active)
  mfaEnabled              Boolean                  @default(false) @map("mfa_enabled")
  mfaSecret               String?                  @map("mfa_secret") @db.VarChar(255)
  lastLoginAt             DateTime?                @map("last_login_at")
  onboardingComplete      Boolean                  @default(true) @map("onboarding_complete")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordHistory         PasswordHistory[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  hotel                   Hotel?                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, email])
  @@index([hotelId])
  @@index([email])
  @@map("users")
}

/// Room entity - hotel room types
model Room {
  id          String     @id @default(uuid())
  hotelId     String     @map("hotel_id")
  name        String     @db.VarChar(255)
  type        String     @db.VarChar(100)
  description String?
  capacity    Int
  basePrice   Decimal    @map("base_price") @db.Decimal(10, 2)
  currency    String     @default("USD") @db.VarChar(3)
  amenities   Json       @default("[]")
  images      Json       @default("[]")
  status      RoomStatus @default(active)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  bookings    Booking[]
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([hotelId, status])
  @@map("rooms")
}

/// Booking entity - guest reservations
model Booking {
  id              String        @id @default(uuid())
  hotelId         String        @map("hotel_id")
  roomId          String        @map("room_id")
  bookingNumber   String        @unique @map("booking_number") @db.VarChar(20)
  guestName       String        @map("guest_name") @db.VarChar(255)
  guestEmail      String        @map("guest_email") @db.VarChar(255)
  guestPhone      String?       @map("guest_phone") @db.VarChar(50)
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime      @map("check_out") @db.Date
  adults          Int           @default(1)
  children        Int           @default(0)
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  currency        String        @default("USD") @db.VarChar(3)
  status          BookingStatus @default(confirmed)
  specialRequests String?       @map("special_requests")
  source          BookingSource @default(widget)
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  room            Room          @relation(fields: [roomId], references: [id])
  conversation    Conversation?

  @@index([hotelId])
  @@index([hotelId, checkIn, checkOut])
  @@index([hotelId, status])
  @@index([bookingNumber])
  @@index([guestEmail])
  @@map("bookings")
}

/// Hotel knowledge base entries for AI
model HotelKnowledge {
  id        String            @id @default(uuid())
  hotelId   String            @map("hotel_id")
  category  KnowledgeCategory
  key       String            @db.VarChar(255)
  value     String
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  hotel     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, category, key])
  @@index([hotelId])
  @@index([hotelId, category])
  @@map("hotel_knowledge")
}

/// Chat conversation sessions
model Conversation {
  id           String                @id @default(uuid())
  hotelId      String                @map("hotel_id")
  sessionId    String                @map("session_id") @db.VarChar(255)
  visitorId    String?               @map("visitor_id") @db.VarChar(255)
  startedAt    DateTime              @default(now()) @map("started_at")
  endedAt      DateTime?             @map("ended_at")
  messageCount Int                   @default(0) @map("message_count")
  bookingId    String?               @unique @map("booking_id")
  metadata     Json                  @default("{}")
  messages     ConversationMessage[]
  booking      Booking?              @relation(fields: [bookingId], references: [id])
  hotel        Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, sessionId])
  @@index([hotelId])
  @@index([sessionId])
  @@map("conversations")
}

/// Individual chat messages
model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  content        String
  intent         String?      @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

/// Audit log for tracking changes
model AuditLog {
  id         String   @id @default(uuid())
  hotelId    String?  @map("hotel_id")
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  hotel      Hotel?   @relation(fields: [hotelId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([hotelId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Refresh tokens for authentication
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Password reset tokens
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Email verification tokens
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  email      String    @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Email delivery log for tracking and monitoring
model EmailLog {
  id           String      @id @default(uuid())
  hotelId      String?     @map("hotel_id")
  messageId    String?     @unique @map("message_id") @db.VarChar(255)
  template     String      @db.VarChar(100)
  recipient    String      @db.VarChar(255)
  subject      String      @db.VarChar(500)
  status       EmailStatus @default(queued)
  errorMessage String?     @map("error_message")
  sentAt       DateTime?   @map("sent_at")
  deliveredAt  DateTime?   @map("delivered_at")
  bouncedAt    DateTime?   @map("bounced_at")
  bounceType   String?     @map("bounce_type") @db.VarChar(50)
  complainedAt DateTime?   @map("complained_at")
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([hotelId])
  @@index([messageId])
  @@index([recipient])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

/// Password history for preventing password reuse
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("password_history")
}

/// Scrape job for tracking hotel website scraping
model ScrapeJob {
  id           String       @id @default(uuid())
  hotelId      String       @map("hotel_id")
  url          String       @db.VarChar(2048)
  status       ScrapeStatus @default(pending)
  pagesScraped Int          @default(0) @map("pages_scraped")
  entriesFound Int          @default(0) @map("entries_found")
  errorMessage String?      @map("error_message")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([status])
  @@map("scrape_jobs")
}

enum HotelStatus {
  active
  suspended
  deleted
}

enum SubscriptionTier {
  basic
  standard
  premium
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired
}

enum UserRole {
  super_admin
  hotel_owner
  hotel_manager
  hotel_staff
}

enum UserStatus {
  active
  inactive
  suspended
  pending_verification
}

enum RoomStatus {
  active
  inactive
  maintenance
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
  completed
  no_show
}

enum BookingSource {
  widget
  admin
  api
}

enum MessageRole {
  user
  assistant
  system
}

enum KnowledgeCategory {
  general
  rooms
  policies
  faqs
  location
  amenities
  services
}

enum ScrapeStatus {
  pending
  crawling
  searching
  extracting
  importing
  completed
  failed
}

enum EmailStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
}
